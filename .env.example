# Скопировать в .env и заполнить. .env в репозиторий не коммитится.

# База данных
DB_NAME=okoyom
DB_USER=okoyom
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Порты локальной разработки
HTTP_PORT=8080
MAILPIT_PORT=8025

# Окружение: local | staging | prod.
# Пишется в каждую заявку и отличает тестовые письма от боевых.
OKOYOM_ENV=local
WP_DEBUG=true
